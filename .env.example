# Database Settings
# Supports standard Postgres connection string (Neon serverless or local pg)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/thunder_db"
# Better Auth Configuration
BETTER_AUTH_SECRET="some_super_secret_32_characters_long_key"
BETTER_AUTH_URL="http://localhost:4000" # Address of the Hono backend server

# Frontend Configuration
CLIENT_URL="http://localhost:3000" # Address of the Next.js frontend
NEXT_PUBLIC_APP_URL="https://your-domain.com" # Public domain for sharing and web app (optional)
NEXT_PUBLIC_SERVER_URL="http://localhost:4000" # Hono server URL for Next.js client
EXPO_PUBLIC_SERVER_URL="http://localhost:4000" # Hono server URL for Expo mobile client
NEXT_PUBLIC_IS_DOCS_ONLY="false" # Set to true for live Docs site deployments (Vercel/Cloudflare)

# Google OAuth Config (Obtain from Google Cloud Console)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Expo Mobile Google OAuth Config (For client-side/native authentication)
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB="your-expo-web-client-id.apps.googleusercontent.com"
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS="your-expo-ios-client-id.apps.googleusercontent.com"
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID="your-expo-android-client-id.apps.googleusercontent.com"

# SMTP / Nodemailer Configuration (Gmail App Password)
SMTP_EMAIL="your-email@gmail.com"
SMTP_APP_PASSWORD="your-gmail-app-password"
SMTP_NAME="THUNDER Stack"

# Cloudflare Tunnel Configuration (Optional: persistent named tunnel token or auto trycloudflare)
# CLOUDFLARE_TUNNEL_TOKEN="your-cloudflare-tunnel-token"

# =============================================================================
# Kaggle Cloud Training Configuration (Optional)
# =============================================================================
# One-time flow:
#   1. Export dataset: python ml/scripts/export_for_colab.py --src . --dst ../bme_colab_export --mapping-file ../bme_recovery/export_mapping.json
#   2. Approve dataset: pnpm kaggle:approve --confirm-approve
#   3. Upload once (fast network recommended): pnpm kaggle:upload --confirm-upload
#
# Per-run flow:
#   Launch training & auto-import: pnpm kaggle:run --mode quick --confirm-launch
#   Modes available: quick, bench, fold0, full, eval_suite
#   Fetch / Resume: pnpm kaggle:fetch
#
# Import policy:
#   Only complete full 5-fold runs with matching fingerprints are imported into data/results3d.
#   All other modes/incomplete runs are safely archived to data/results3d_experiments/<run_id>/.
#
# Stale-build warning:
#   Rebuild after pulling changes: pnpm build && next start -H 127.0.0.1
#
# Manual fallback:
#   Upload exported folder directly via kaggle.com web UI as private dataset.
#
# Placeholders (Strictly outside repository and data/ directory):
KAGGLE_DATASET_SLUG="bme-3d-dataset"
KAGGLE_STAGING_DIR="../bme_kaggle_staging"
